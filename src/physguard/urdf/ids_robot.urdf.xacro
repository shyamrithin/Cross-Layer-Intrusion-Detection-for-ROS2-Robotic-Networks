<?xml version="1.0"?>
<!--
================================================================================
 File        : ids_robot.urdf.xacro
 Package     : physguard
 Project     : Cross-Layer Intrusion Detection for ROS 2 Robotic Networks
 Author      : Shyam Rithin S (RA2311004010308)
================================================================================
 Description
 
 Differential-drive robot description for the IDS bench, matching the
 articubot_one platform the detector targets:
     wheel radius 32.5 mm, wheel separation 250 mm, two casters, RPLIDAR A2M8.

 Structure
   base_link (chassis, root)
     +- left_wheel_joint  (continuous)  -> left_wheel
     +- right_wheel_joint (continuous)  -> right_wheel
     +- front_caster_joint (fixed)      -> front_caster   (frictionless)
     +- rear_caster_joint  (fixed)      -> rear_caster    (frictionless)
     +- lidar_joint        (fixed)      -> lidar_link     (gpu_lidar sensor)

 The gz-sim DiffDrive system drives the wheel joints, consumes /cmd_vel and
 publishes /odom and the odom->base_link TF. robot_state_publisher publishes
 the fixed base_link->{wheels,casters,lidar} transforms from this file, so the
 same description serves Gazebo, RViz2 and (later) the real robot.

 Casters sit 3 mm clear of the ground so the drive wheels carry the load;
 coplanar contacts let the frictionless casters steal traction and the wheels
 slip, which corrupts odometry.
================================================================================
-->
<robot name="ids_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======== parameters ======== -->
  <xacro:property name="wheel_radius"    value="0.0325"/>
  <xacro:property name="wheel_width"     value="0.020"/>
  <xacro:property name="wheel_sep"       value="0.250"/>
  <xacro:property name="chassis_x"       value="0.30"/>
  <xacro:property name="chassis_y"       value="0.22"/>
  <xacro:property name="chassis_z"       value="0.08"/>
  <xacro:property name="chassis_mass"    value="1.5"/>
  <xacro:property name="wheel_mass"      value="0.10"/>
  <xacro:property name="caster_radius"   value="0.020"/>
  <!-- caster centre height: sphere bottom 3 mm above ground -->
  <xacro:property name="caster_z"        value="${-wheel_radius + caster_radius + 0.003}"/>

  <!-- ======== materials ======== -->
  <material name="chassis_blue"><color rgba="0.08 0.31 0.61 1"/></material>
  <material name="deck_slate"><color rgba="0.20 0.24 0.30 1"/></material>
  <material name="marker_white"><color rgba="0.95 0.95 0.95 1"/></material>
  <material name="wheel_black"><color rgba="0.10 0.10 0.10 1"/></material>
  <material name="hub_grey"><color rgba="0.62 0.65 0.69 1"/></material>
  <material name="lidar_dark"><color rgba="0.10 0.10 0.10 1"/></material>
  <material name="accent_red"><color rgba="0.82 0.20 0.18 1"/></material>

  <!-- ======== macros ======== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" iyy="${m*(x*x+z*z)/12.0}"
               izz="${m*(x*x+y*y)/12.0}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <visual name="hub">
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius*0.5}" length="${wheel_width*1.08}"/></geometry>
        <material name="hub_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="2.97e-5" iyy="2.97e-5" izz="5.28e-5" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${reflect*wheel_sep/2.0} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="caster" params="prefix x">
    <link name="${prefix}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="3.2e-6" iyy="3.2e-6" izz="3.2e-6" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster"/>
      <origin xyz="${x} 0 ${caster_z}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${prefix}_caster">
      <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <!-- ======== chassis (root) ======== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z/2.0}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="chassis_blue"/>
    </visual>
    <visual name="deck">
      <origin xyz="-0.01 0 ${chassis_z + 0.02}" rpy="0 0 0"/>
      <geometry><box size="0.22 0.18 0.04"/></geometry>
      <material name="deck_slate"/>
    </visual>
    <visual name="front_bumper">
      <origin xyz="${chassis_x/2.0} 0 ${chassis_z/2.0 - 0.005}" rpy="0 0 0"/>
      <geometry><box size="0.02 0.22 0.05"/></geometry>
      <material name="accent_red"/>
    </visual>
    <visual name="front_marker">
      <origin xyz="${chassis_x/2.0 - 0.02} 0 ${chassis_z/2.0 + 0.035}" rpy="0 0 0"/>
      <geometry><box size="0.04 0.18 0.01"/></geometry>
      <material name="marker_white"/>
    </visual>
    <visual name="antenna">
      <origin xyz="${-chassis_x/2.0 + 0.03} 0.07 ${chassis_z + 0.08}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.004" length="0.16"/></geometry>
      <material name="accent_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z/2.0}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_x}" y="${chassis_y}" z="${chassis_z}"/>
  </link>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>
  <xacro:caster prefix="front" x="0.11"/>
  <xacro:caster prefix="rear"  x="-0.11"/>

  <!-- ======== lidar ======== -->
  <link name="lidar_link">
    <visual name="mount">
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.05"/></geometry>
      <material name="deck_slate"/>
    </visual>
    <visual name="drum">
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="lidar_dark"/>
    </visual>
    <visual name="scan_ring">
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry><cylinder radius="0.041" length="0.008"/></geometry>
      <material name="accent_red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="4.5e-5" iyy="4.5e-5" izz="8.0e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.02 0 ${chassis_z + 0.03}" rpy="0 0 0"/>
  </joint>

  <!-- ======== Gazebo: lidar sensor ======== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan><horizontal>
          <samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
        </horizontal></scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>1</always_on><visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ======== Gazebo: differential drive + joint states ======== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>1.6</max_linear_acceleration>
      <min_linear_acceleration>-1.6</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
